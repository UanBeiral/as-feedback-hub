# Copie para .env e preencha. NUNCA versione o .env.

ENVIRONMENT=development
DEBUG=true

# Banco — a aplicação lê DATABASE_URL; o container do Postgres lê as três POSTGRES_*.
# Mantenha usuário, senha e base coerentes entre as duas: quem sobe o compose com uma
# senha e aponta a DATABASE_URL para outra descobre isso no primeiro login, não no boot.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/asfeedback
DB_ECHO=false

# Credenciais do container `postgres` (deploy/docker-compose.yml). POSTGRES_PASSWORD não
# tem default no compose de propósito: subir banco com senha implícita é como o legado
# começou. Sem ela, o `docker compose up` falha antes de criar qualquer coisa.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=asfeedback

# Fila / cache
REDIS_URL=redis://localhost:6379/0

# Auth (AD-03) — gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Email (BR-MIGRAR-030 / R-11)
EMAIL_PROVIDER=console
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=nao-responda@exemplo.com

# Web
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
