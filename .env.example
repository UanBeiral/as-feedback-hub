# Copie para .env e preencha. NUNCA versione o .env.

ENVIRONMENT=development
DEBUG=true

# Banco
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/asfeedback
DB_ECHO=false

# Fila / cache
REDIS_URL=redis://localhost:6379/0

# Auth (AD-03) — gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Email (BR-MIGRAR-030 / R-11)
EMAIL_PROVIDER=console
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=nao-responda@exemplo.com

# Web
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
